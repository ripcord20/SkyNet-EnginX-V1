<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    :root { --ns-blue:#2563eb; --border:#e2e8f0; --text:#0f172a; --muted:#64748b; }
    .ns { font-family:'Plus Jakarta Sans',sans-serif; }
    .ns-hdr { display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:22px; }
    .ns-hdr h1 { font-size:22px; font-weight:800; color:var(--text); margin:0 0 4px; }
    .ns-hdr p { font-size:13px; color:var(--muted); margin:0; }
    .ns-hdr-r { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
    .btn { display:inline-flex; align-items:center; gap:6px; padding:9px 16px; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer; border:1px solid; font-family:inherit; }
    .btn-outline { background:#fff; border-color:var(--border); color:#374151; }
    .btn-blue { background:var(--ns-blue); border-color:var(--ns-blue); color:#fff; }
    .btn-sm { padding:6px 12px; font-size:12px; border-radius:8px; }
    .ns-cards { display:grid; grid-template-columns:repeat(3,1fr); background:#fff; border-radius:16px; border:1px solid #e8eaed; overflow:hidden; margin:0 0 36px; }
    .ns-card { padding:18px 20px; border-right:1px solid #e8eaed; text-align:center; }
    .ns-card:last-child { border-right:none; }
    .card-lbl { font-size:12px; font-weight:500; color:#64748b; margin-bottom:8px; }
    .card-val { font-size:28px; font-weight:800; color:#0f172a; line-height:1; }
    .ns-panel { background:#fff; border:1px solid var(--border); border-radius:16px; overflow:hidden; margin-top:8px; }
    .ns-toolbar { display:flex; gap:8px; padding:12px 16px; border-bottom:1px solid var(--border); flex-wrap:wrap; align-items:center; }
    .ns-table { width:100%; border-collapse:collapse; }
    .ns-table th { padding:11px 14px; font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.5px; background:#f8fafc; border-bottom:1px solid var(--border); text-align:left; }
    .ns-table td { padding:12px 14px; font-size:13px; border-bottom:1px solid #f1f5f9; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size:12px; }
    .act-btn { width:30px; height:30px; border:1px solid var(--border); background:#fff; border-radius:8px; cursor:pointer; color:#64748b; }
    .act-btn.danger { color:#dc2626; }
    .modal { display:none; position:fixed; inset:0; width:auto !important; max-width:none !important; background:rgba(15,23,42,.45); z-index:80; padding:16px; overflow:auto; }
    .modal.show { display:block; }
    .modal-box { background:#fff; border-radius:16px; width:100%; max-width:480px; margin:12px auto; box-shadow:0 16px 40px rgba(15,23,42,.18); }
    .modal-hd { display:flex; justify-content:space-between; align-items:center; padding:16px 18px; border-bottom:1px solid var(--border); font-weight:800; }
    .modal-bd { padding:16px 18px; display:flex; flex-direction:column; gap:12px; }
    .modal-ft { padding:12px 18px; border-top:1px solid var(--border); display:flex; justify-content:flex-end; gap:8px; }
    .field label { display:block; font-size:12px; font-weight:700; color:#475569; margin-bottom:5px; }
    .field input, .field select { width:100%; padding:9px 12px; border:1px solid var(--border); border-radius:10px; font-size:13px; font-family:inherit; box-sizing:border-box; }
    .hint { font-size:12px; color:var(--muted); line-height:1.55; background:#f8fafc; border:1px solid var(--border); border-radius:10px; padding:10px 12px; margin-bottom:16px; }
    .empty { text-align:center; padding:48px 16px; color:var(--muted); }
    @media(max-width:700px){ .ns-cards{grid-template-columns:1fr;} .ns-card{border-right:none;border-bottom:1px solid #e8eaed;} }
  </style>
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <main class="page-content ns">
      <div class="ns-hdr">
        <div>
          <h1>NAS RADIUS</h1>
          <p>Daftar Network Access Server (router) yang boleh otentikasi ke FreeRADIUS</p>
        </div>
        <div class="ns-hdr-r">
          <button class="btn btn-outline btn-sm" onclick="loadNas()">Refresh</button>
          <button class="btn btn-outline btn-sm" onclick="syncNas()">Sinkron dari Devices</button>
          <button class="btn btn-blue btn-sm" onclick="openNasModal()">+ NAS</button>
        </div>
      </div>

      <div class="hint">
        Setiap MikroTik yang memakai RADIUS harus terdaftar di sini (IP = <code>nasname</code>, secret sama dengan di <code>/radius add</code>).
        PPPoE user tersimpan di RADIUS; tanpa NAS yang cocok, Auth-Request dari router ditolak.
      </div>

      <div class="ns-cards">
        <div class="ns-card"><div class="card-lbl">NAS</div><div class="card-val" id="stNas">–</div></div>
        <div class="ns-card"><div class="card-lbl">User RADIUS</div><div class="card-val" id="stUsers">–</div></div>
        <div class="ns-card"><div class="card-lbl">Online</div><div class="card-val" id="stOnline">–</div></div>
      </div>

      <section class="ns-panel">
        <div class="ns-toolbar">
          <span style="font-size:13px;font-weight:800;flex:1">Daftar NAS</span>
        </div>
        <div style="overflow:auto">
          <table class="ns-table">
            <thead><tr><th>Nama</th><th>IP / Host</th><th>Tipe</th><th>Secret</th><th>Deskripsi</th><th></th></tr></thead>
            <tbody id="nasTbody"><tr><td colspan="6" class="empty">Memuat...</td></tr></tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
</div>

<div class="modal" id="nasModal">
  <div class="modal-box">
    <div class="modal-hd"><span id="nasModalTitle">NAS</span><button class="act-btn" onclick="closeModal()">✕</button></div>
    <div class="modal-bd">
      <input type="hidden" id="nId">
      <div class="field"><label>IP / hostname *</label><input id="nHost" placeholder="192.168.22.1"></div>
      <div class="field"><label>Nama pendek</label><input id="nShort" placeholder="CORE"></div>
      <div class="field"><label>Secret *</label><input id="nSecret" placeholder="shared secret"></div>
      <div class="field">
        <label>Tipe</label>
        <select id="nType">
          <option value="mikrotik">mikrotik</option>
          <option value="other">other</option>
        </select>
      </div>
      <div class="field"><label>Deskripsi</label><input id="nDesc"></div>
    </div>
    <div class="modal-ft">
      <button class="btn btn-outline btn-sm" onclick="closeModal()">Batal</button>
      <button class="btn btn-blue btn-sm" onclick="saveNas()">Simpan</button>
    </div>
  </div>
</div>

<script src="/js/app.js"></script>
<script>
function esc(v) {
  return String(v == null ? '' : v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function closeModal() { document.getElementById('nasModal').classList.remove('show'); }

async function loadNas() {
  const [st, nas] = await Promise.all([App.api('/radius/stats'), App.api('/radius/nas')]);
  if (st?.success) {
    const d = st.data || {};
    document.getElementById('stNas').textContent = d.nas ?? 0;
    document.getElementById('stUsers').textContent = d.users ?? 0;
    document.getElementById('stOnline').textContent = d.online ?? 0;
  }
  const tb = document.getElementById('nasTbody');
  const list = nas?.data || [];
  if (!list.length) {
    tb.innerHTML = '<tr><td colspan="6" class="empty">Belum ada NAS. Sinkron dari Device Management atau tambah manual.</td></tr>';
    return;
  }
  tb.innerHTML = list.map(n => `
    <tr>
      <td><strong>${esc(n.shortname || n.nasname)}</strong></td>
      <td class="mono">${esc(n.nasname)}</td>
      <td>${esc(n.type || 'mikrotik')}</td>
      <td class="mono">${esc(n.secret || '')}</td>
      <td>${esc(n.description || '—')}</td>
      <td style="white-space:nowrap">
        <button class="act-btn" onclick='editNas(${JSON.stringify(n).replace(/'/g,"&#39;")})'>✎</button>
        <button class="act-btn danger" onclick="deleteNas(${n.id})">✕</button>
      </td>
    </tr>`).join('');
}

function openNasModal() {
  document.getElementById('nId').value = '';
  document.getElementById('nHost').value = '';
  document.getElementById('nShort').value = '';
  document.getElementById('nSecret').value = '';
  document.getElementById('nType').value = 'mikrotik';
  document.getElementById('nDesc').value = '';
  document.getElementById('nasModalTitle').textContent = 'Tambah NAS';
  document.getElementById('nasModal').classList.add('show');
}
function editNas(n) {
  document.getElementById('nId').value = n.id;
  document.getElementById('nHost').value = n.nasname || '';
  document.getElementById('nShort').value = n.shortname || '';
  document.getElementById('nSecret').value = n.secret || '';
  document.getElementById('nType').value = n.type || 'mikrotik';
  document.getElementById('nDesc').value = n.description || '';
  document.getElementById('nasModalTitle').textContent = 'Edit NAS';
  document.getElementById('nasModal').classList.add('show');
}
async function saveNas() {
  const id = document.getElementById('nId').value;
  const body = {
    nasname: document.getElementById('nHost').value.trim(),
    shortname: document.getElementById('nShort').value.trim(),
    secret: document.getElementById('nSecret').value,
    type: document.getElementById('nType').value.trim() || 'mikrotik',
    description: document.getElementById('nDesc').value.trim()
  };
  if (!body.nasname) { App.showToast('IP / hostname wajib diisi', 'error'); return; }
  const url = id ? '/radius/nas/' + id : '/radius/nas';
  const r = await App.api(url, { method: id ? 'PUT' : 'POST', body: JSON.stringify(body) });
  if (r?.success) { closeModal(); App.showToast(r.message, 'success'); await loadNas(); }
  else App.showToast(r?.message || 'Gagal', 'error');
}
async function deleteNas(id) {
  if (!confirm('Hapus NAS ini? Router tersebut tidak bisa otentikasi RADIUS lagi.')) return;
  const r = await App.api('/radius/nas/' + id, { method:'DELETE' });
  App.showToast(r?.success ? 'NAS dihapus' : (r?.message || 'Gagal'), r?.success ? 'success' : 'error');
  await loadNas();
}
async function syncNas() {
  const r = await App.api('/radius/nas/sync-devices', { method:'POST', body:'{}' });
  App.showToast(r?.message || 'Selesai', r?.success ? 'success' : 'error');
  await loadNas();
}

document.addEventListener('DOMContentLoaded', loadNas);
</script>
</body>
</html>
