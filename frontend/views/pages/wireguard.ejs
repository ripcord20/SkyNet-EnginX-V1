<!DOCTYPE html>
<html lang="id" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> - <%= appName %></title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/app.css">
  <style>
    :root { --wg-blue:#2563eb; --border:#e2e8f0; --text:#0f172a; --muted:#64748b; }
    .wg { font-family:'Plus Jakarta Sans',sans-serif; }
    .wg-hdr { display:flex; align-items:flex-start; justify-content:space-between; flex-wrap:wrap; gap:12px; margin-bottom:22px; }
    .wg-hdr h1 { font-size:22px; font-weight:800; color:var(--text); margin:0 0 4px; }
    .wg-hdr p { font-size:13px; color:var(--muted); margin:0; }
    .wg-hdr-r { display:flex; gap:8px; flex-wrap:wrap; align-items:center; }
    .btn { display:inline-flex; align-items:center; gap:6px; padding:9px 16px; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer; border:1px solid; font-family:inherit; }
    .btn-outline { background:#fff; border-color:var(--border); color:#374151; }
    .btn-blue { background:var(--wg-blue); border-color:var(--wg-blue); color:#fff; }
    .btn-sm { padding:6px 12px; font-size:12px; border-radius:8px; }
    .wg-cards { display:grid; grid-template-columns:repeat(4,1fr); background:#fff; border-radius:16px; border:1px solid #e8eaed; overflow:hidden; margin-bottom:18px; }
    .wg-card { padding:18px 20px; border-right:1px solid #e8eaed; text-align:center; }
    .wg-card:last-child { border-right:none; }
    .card-lbl { font-size:12px; font-weight:500; color:#64748b; margin-bottom:8px; }
    .card-val { font-size:28px; font-weight:800; color:#0f172a; line-height:1; }
    .wg-panel { background:#fff; border:1px solid var(--border); border-radius:16px; overflow:hidden; margin-bottom:16px; }
    .wg-toolbar { display:flex; gap:8px; padding:12px 16px; border-bottom:1px solid var(--border); flex-wrap:wrap; align-items:center; }
    .wg-toolbar h2 { font-size:14px; font-weight:800; margin:0; flex:1; }
    .wg-table { width:100%; border-collapse:collapse; }
    .wg-table th { padding:11px 14px; font-size:11px; font-weight:700; color:var(--muted); text-transform:uppercase; letter-spacing:.5px; background:#f8fafc; border-bottom:1px solid var(--border); text-align:left; }
    .wg-table td { padding:12px 14px; font-size:13px; border-bottom:1px solid #f1f5f9; }
    .mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size:12px; word-break:break-all; }
    .pill { display:inline-flex; align-items:center; gap:4px; padding:2px 8px; border-radius:20px; font-size:11px; font-weight:700; }
    .pill-on { background:#dcfce7; color:#15803d; }
    .pill-off { background:#fee2e2; color:#b91c1c; }
    .pill-live { background:#dbeafe; color:#1d4ed8; }
    .act-btn { width:30px; height:30px; border:1px solid var(--border); background:#fff; border-radius:8px; cursor:pointer; color:#64748b; }
    .act-btn.danger { color:#dc2626; }
    .pp-modal-overlay { display:none; position:fixed; inset:0; width:auto !important; max-width:none !important; background:rgba(0,0,0,.45); z-index:1000; align-items:center; justify-content:center; backdrop-filter:blur(3px); padding:16px; }
    .pp-modal-overlay.show { display:flex !important; }
    .pp-modal { background:#fff; border-radius:16px; padding:28px; width:92%; max-width:520px; max-height:92vh; overflow-y:auto; box-shadow:0 20px 60px rgba(0,0,0,.2); animation:ppIn .2s ease; }
    @keyframes ppIn { from{opacity:0;transform:translateY(14px) scale(.97)} to{opacity:1;transform:none} }
    .pp-modal-hdr { display:flex; align-items:center; justify-content:space-between; margin-bottom:20px; }
    .pp-modal-hdr h3 { font-size:16px; font-weight:800; margin:0; color:#0f172a; }
    .pp-modal-close { width:30px;height:30px;border-radius:8px;border:none;background:#f8fafc;cursor:pointer;font-size:18px;color:#64748b;display:flex;align-items:center;justify-content:center;transition:all .15s; }
    .pp-modal-close:hover { background:#fee2e2; color:#dc2626; }
    .pp-form-grid { display:grid; grid-template-columns:1fr 1fr; gap:14px; }
    @media(max-width:480px){ .pp-form-grid { grid-template-columns:1fr; } }
    .pp-form-group { display:flex; flex-direction:column; gap:5px; }
    .pp-form-group.full { grid-column:1/-1; }
    .pp-form-label { font-size:12px; font-weight:600; color:#374151; }
    .pp-form-label span { color:#dc2626; }
    .pp-form-control { padding:9px 12px; border:1.5px solid #e2e8f0; border-radius:9px; font-size:13px; font-family:inherit; color:#0f172a; outline:none; transition:border-color .15s,box-shadow .15s; background:#fff; width:100%; box-sizing:border-box; }
    .pp-form-control:focus { border-color:#2563eb; box-shadow:0 0 0 3px rgba(37,99,235,.12); }
    .pp-form-control::placeholder { color:#94a3b8; }
    textarea.pp-form-control { min-height:72px; resize:vertical; }
    .pp-form-control.mono { font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size:12px; }
    .pp-form-hint { font-size:11px; color:#94a3b8; }
    .pp-modal-footer { display:flex; gap:10px; justify-content:flex-end; margin-top:20px; padding-top:16px; border-top:1px solid #f1f5f9; }
    .btn-pp-save { background:#2563eb; color:#fff; border:none; padding:10px 22px; border-radius:10px; font-size:13px; font-weight:700; cursor:pointer; font-family:inherit; transition:background .15s; }
    .btn-pp-save:hover { background:#1d4ed8; }
    .btn-pp-cancel { background:#f8fafc; color:#374151; border:1.5px solid #e2e8f0; padding:9px 18px; border-radius:10px; font-size:13px; font-weight:600; cursor:pointer; font-family:inherit; transition:all .15s; }
    .btn-pp-cancel:hover { background:#f1f5f9; }
    .empty { text-align:center; padding:40px 16px; color:var(--muted); }
    .hint { font-size:12px; color:var(--muted); line-height:1.5; background:#f8fafc; border:1px solid var(--border); border-radius:10px; padding:10px 12px; }
    @media(max-width:900px){ .wg-cards{grid-template-columns:repeat(2,1fr);} }
  </style>
</head>
<body>
<div class="app-layout">
  <%- include('../partials/sidebar') %>
  <div class="main-content">
    <%- include('../partials/topbar') %>
    <main class="page-content wg">
      <div class="wg-hdr">
        <div>
          <h1>WireGuard</h1>
          <p>Interface &amp; peer VPN WireGuard di MikroTik. Butuh REST/API (bukan SNMP saja). Package <code>wireguard</code> harus aktif di router.</p>
        </div>
        <div class="wg-hdr-r">
          <div id="mtSelectorMount"></div>
          <button class="btn btn-outline btn-sm" onclick="loadAll()">Refresh</button>
          <button class="btn btn-blue btn-sm" onclick="openIfaceModal()">+ Interface</button>
          <button class="btn btn-blue btn-sm" onclick="openPeerModal()">+ Peer</button>
        </div>
      </div>

      <div class="wg-cards">
        <div class="wg-card"><div class="card-lbl">Interface</div><div class="card-val" id="stIf">–</div></div>
        <div class="wg-card"><div class="card-lbl">Peer</div><div class="card-val" id="stPeer">–</div></div>
        <div class="wg-card"><div class="card-lbl">Online</div><div class="card-val" id="stOn">–</div></div>
        <div class="wg-card"><div class="card-lbl">Disabled</div><div class="card-val" id="stOff">–</div></div>
      </div>

      <section class="wg-panel">
        <div class="wg-toolbar"><h2>Interface</h2></div>
        <div style="overflow:auto">
          <table class="wg-table">
            <thead><tr><th>Nama</th><th>Listen port</th><th>Public key</th><th>Status</th><th></th></tr></thead>
            <tbody id="ifTbody"><tr><td colspan="5" class="empty">Memuat...</td></tr></tbody>
          </table>
        </div>
      </section>

      <section class="wg-panel">
        <div class="wg-toolbar"><h2>Peers</h2></div>
        <div style="overflow:auto">
          <table class="wg-table">
            <thead><tr><th>Nama / comment</th><th>Interface</th><th>Allowed</th><th>Handshake</th><th>Traffic</th><th></th></tr></thead>
            <tbody id="peerTbody"><tr><td colspan="6" class="empty">Memuat...</td></tr></tbody>
          </table>
        </div>
      </section>
    </main>
  </div>
</div>

<div class="pp-modal-overlay" id="ifModal">
  <div class="pp-modal">
    <div class="pp-modal-hdr">
      <h3 id="ifModalTitle">Tambah Interface WireGuard</h3>
      <button type="button" class="pp-modal-close" onclick="closeModal('ifModal')">×</button>
    </div>
    <input type="hidden" id="ifId">
    <div class="pp-form-grid">
      <div class="pp-form-group">
        <label class="pp-form-label">Nama <span>*</span></label>
        <input class="pp-form-control" id="ifName" placeholder="e.g. wg-sky">
      </div>
      <div class="pp-form-group">
        <label class="pp-form-label">Listen port</label>
        <input class="pp-form-control" id="ifPort" type="number" placeholder="e.g. 13231">
        <span class="pp-form-hint">Kosongkan = default router</span>
      </div>
      <div class="pp-form-group">
        <label class="pp-form-label">MTU</label>
        <input class="pp-form-control" id="ifMtu" placeholder="e.g. 1420">
        <span class="pp-form-hint">Kosongkan = 1420</span>
      </div>
      <div class="pp-form-group full">
        <label class="pp-form-label">Comment</label>
        <textarea class="pp-form-control" id="ifComment" placeholder="Keterangan opsional..."></textarea>
      </div>
    </div>
    <div class="pp-modal-footer">
      <button type="button" class="btn-pp-cancel" onclick="closeModal('ifModal')">Batal</button>
      <button type="button" class="btn-pp-save" onclick="saveIface()">Simpan</button>
    </div>
  </div>
</div>

<div class="pp-modal-overlay" id="peerModal">
  <div class="pp-modal">
    <div class="pp-modal-hdr">
      <h3 id="peerModalTitle">Tambah Peer WireGuard</h3>
      <button type="button" class="pp-modal-close" onclick="closeModal('peerModal')">×</button>
    </div>
    <input type="hidden" id="peerId">
    <div class="pp-form-grid">
      <div class="pp-form-group">
        <label class="pp-form-label">Interface <span>*</span></label>
        <select class="pp-form-control" id="peerIface"></select>
      </div>
      <div class="pp-form-group">
        <label class="pp-form-label">Comment / nama</label>
        <input class="pp-form-control" id="peerComment" placeholder="e.g. teknisi-1">
      </div>
      <div class="pp-form-group">
        <label class="pp-form-label">Allowed address</label>
        <input class="pp-form-control" id="peerAllowed" placeholder="e.g. 10.10.10.2/32">
        <span class="pp-form-hint">IP VPN yang diizinkan untuk peer ini</span>
      </div>
      <div class="pp-form-group">
        <label class="pp-form-label">Keepalive</label>
        <input class="pp-form-control" id="peerKa" placeholder="e.g. 25s">
        <span class="pp-form-hint">Kosongkan = tanpa keepalive</span>
      </div>
      <div class="pp-form-group">
        <label class="pp-form-label">Endpoint</label>
        <input class="pp-form-control" id="peerEp" placeholder="e.g. 1.2.3.4">
        <span class="pp-form-hint">Opsional — IP publik peer</span>
      </div>
      <div class="pp-form-group">
        <label class="pp-form-label">Endpoint port</label>
        <input class="pp-form-control" id="peerEpPort" placeholder="e.g. 13231">
      </div>
      <div class="pp-form-group full">
        <label class="pp-form-label">Public key</label>
        <input class="pp-form-control mono" id="peerPub" placeholder="Kosongkan = generate otomatis">
        <span class="pp-form-hint">Kosongkan = generate otomatis di router</span>
      </div>
      <div class="pp-form-group full" id="peerKeyHint" style="display:none"></div>
    </div>
    <div class="pp-modal-footer">
      <button type="button" class="btn-pp-cancel" onclick="closeModal('peerModal')">Batal</button>
      <button type="button" class="btn-pp-save" onclick="savePeer()">Simpan</button>
    </div>
  </div>
</div>

<script src="/js/app.js"></script>
<script src="/js/mikrotik-selector.js"></script>
<script>
function _url(path) {
  return (window.MikrotikSelector && window.MikrotikSelector.withDevice)
    ? window.MikrotikSelector.withDevice(path) : path;
}
function esc(v) {
  return String(v == null ? '' : v).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
function closeModal(id) { document.getElementById(id).classList.remove('show'); }
function fmtBytes(n) {
  n = Number(n) || 0;
  if (n < 1024) return n + ' B';
  if (n < 1048576) return (n/1024).toFixed(1) + ' KB';
  if (n < 1073741824) return (n/1048576).toFixed(1) + ' MB';
  return (n/1073741824).toFixed(2) + ' GB';
}
function hsLive(hs) { return hs && !/[dw]/i.test(hs) && !/\d+h/i.test(hs); }

let _IFACES = [];

async function loadAll() {
  try {
    const r = await App.api(_url('/mikrotik/wireguard'));
    if (!r?.success) {
      document.getElementById('ifTbody').innerHTML = '<tr><td colspan="5" class="empty">' + esc(r?.message || 'Gagal memuat') + '</td></tr>';
      document.getElementById('peerTbody').innerHTML = '<tr><td colspan="6" class="empty">' + esc(r?.warning || r?.message || 'Gagal') + '</td></tr>';
      return;
    }
  const d = r.data || {};
  const st = d.stats || {};
  document.getElementById('stIf').textContent = st.interfaces ?? 0;
  document.getElementById('stPeer').textContent = st.peers ?? 0;
  document.getElementById('stOn').textContent = st.online ?? 0;
  document.getElementById('stOff').textContent = st.disabled ?? 0;
  _IFACES = d.interfaces || [];
  renderIfaces(_IFACES);
  renderPeers(d.peers || []);
  } catch (e) {
    document.getElementById('ifTbody').innerHTML = '<tr><td colspan="5" class="empty">' + esc(e.message || 'Gagal memuat') + '</td></tr>';
  }
}

function renderIfaces(list) {
  const tb = document.getElementById('ifTbody');
  if (!list.length) { tb.innerHTML = '<tr><td colspan="5" class="empty">Belum ada interface WireGuard di router ini</td></tr>'; return; }
  tb.innerHTML = list.map(i => `
    <tr>
      <td><strong>${esc(i.name)}</strong>${i.comment ? '<div style="font-size:11px;color:#64748b">' + esc(i.comment) + '</div>' : ''}</td>
      <td class="mono">${esc(i.listenPort || '—')}</td>
      <td class="mono">${esc(i.publicKey || '—')}</td>
      <td>
        ${i.running ? '<span class="pill pill-live">running</span> ' : ''}
        <span class="pill ${i.disabled ? 'pill-off' : 'pill-on'}">${i.disabled ? 'disabled' : 'aktif'}</span>
      </td>
      <td style="white-space:nowrap">
        <button class="act-btn" title="Edit" onclick='editIface(${JSON.stringify(i).replace(/'/g,"&#39;")})'>✎</button>
        <button class="act-btn danger" title="Hapus" onclick="delIface('${esc(i.id)}','${esc(i.name)}')">✕</button>
      </td>
    </tr>`).join('');
}

function renderPeers(list) {
  const tb = document.getElementById('peerTbody');
  if (!list.length) { tb.innerHTML = '<tr><td colspan="6" class="empty">Belum ada peer</td></tr>'; return; }
  tb.innerHTML = list.map(p => `
    <tr>
      <td>${esc(p.comment || p.publicKey.slice(0,12) + '…')}</td>
      <td>${esc(p.interface)}</td>
      <td class="mono">${esc(p.allowedAddress || '—')}</td>
      <td>${p.lastHandshake
        ? '<span class="pill ' + (hsLive(p.lastHandshake) ? 'pill-live' : 'pill-off') + '">' + esc(p.lastHandshake) + '</span>'
        : '<span class="pill pill-off">belum</span>'}</td>
      <td class="mono">↓ ${fmtBytes(p.rx)} · ↑ ${fmtBytes(p.tx)}</td>
      <td style="white-space:nowrap">
        <button class="act-btn" title="Edit" onclick='editPeer(${JSON.stringify(p).replace(/'/g,"&#39;")})'>✎</button>
        <button class="act-btn danger" title="Hapus" onclick="delPeer('${esc(p.id)}')">✕</button>
      </td>
    </tr>`).join('');
}

function fillIfaceSelect(selId, value) {
  const sel = document.getElementById(selId);
  sel.innerHTML = _IFACES.map(i => '<option value="' + esc(i.name) + '"' + (i.name === value ? ' selected' : '') + '>' + esc(i.name) + '</option>').join('')
    || '<option value="">— Buat interface dulu —</option>';
}

function openIfaceModal() {
  document.getElementById('ifId').value = '';
  document.getElementById('ifName').value = '';
  document.getElementById('ifPort').value = '13231';
  document.getElementById('ifMtu').value = '';
  document.getElementById('ifComment').value = '';
  document.getElementById('ifModalTitle').textContent = 'Tambah Interface WireGuard';
  document.getElementById('ifModal').classList.add('show');
}
function editIface(i) {
  document.getElementById('ifId').value = i.id;
  document.getElementById('ifName').value = i.name || '';
  document.getElementById('ifPort').value = i.listenPort || '';
  document.getElementById('ifMtu').value = i.mtu || '';
  document.getElementById('ifComment').value = i.comment || '';
  document.getElementById('ifModalTitle').textContent = 'Edit Interface WireGuard';
  document.getElementById('ifModal').classList.add('show');
}
async function saveIface() {
  const name = document.getElementById('ifName').value.trim();
  if (!name) { App.showToast('Nama interface wajib diisi', 'error'); return; }
  const id = document.getElementById('ifId').value;
  const body = {
    name,
    listenPort: document.getElementById('ifPort').value.trim(),
    mtu: document.getElementById('ifMtu').value.trim(),
    comment: document.getElementById('ifComment').value.trim()
  };
  const btn = document.querySelector('#ifModal .btn-pp-save');
  if (btn) { btn.disabled = true; btn.textContent = 'Menyimpan…'; }
  try {
    const url = id ? '/mikrotik/wireguard/interfaces/' + encodeURIComponent(id) : '/mikrotik/wireguard/interfaces';
    const r = await App.api(_url(url), { method: id ? 'PUT' : 'POST', body: JSON.stringify(body) });
    if (r?.success) { closeModal('ifModal'); App.showToast(r.message, 'success'); await loadAll(); }
    else App.showToast(r?.message || 'Gagal menambah interface WireGuard', 'error');
  } catch (e) {
    App.showToast(e.message || 'Gagal', 'error');
  } finally {
    if (btn) { btn.disabled = false; btn.textContent = 'Simpan'; }
  }
}
async function delIface(id, name) {
  if (!confirm('Hapus interface ' + name + '?')) return;
  const r = await App.api(_url('/mikrotik/wireguard/interfaces/' + encodeURIComponent(id)), { method:'DELETE' });
  App.showToast(r?.success ? 'Dihapus' : (r?.message || 'Gagal'), r?.success ? 'success' : 'error');
  await loadAll();
}

function openPeerModal() {
  document.getElementById('peerId').value = '';
  document.getElementById('peerComment').value = '';
  document.getElementById('peerAllowed').value = '';
  document.getElementById('peerPub').value = '';
  document.getElementById('peerEp').value = '';
  document.getElementById('peerEpPort').value = '';
  document.getElementById('peerKa').value = '25s';
  document.getElementById('peerKeyHint').style.display = 'none';
  fillIfaceSelect('peerIface');
  document.getElementById('peerModalTitle').textContent = 'Tambah Peer WireGuard';
  document.getElementById('peerModal').classList.add('show');
}
function editPeer(p) {
  document.getElementById('peerId').value = p.id;
  document.getElementById('peerComment').value = p.comment || '';
  document.getElementById('peerAllowed').value = p.allowedAddress || '';
  document.getElementById('peerPub').value = p.publicKey || '';
  document.getElementById('peerEp').value = p.endpointAddress || '';
  document.getElementById('peerEpPort').value = p.endpointPort || '';
  document.getElementById('peerKa').value = p.keepalive || '';
  document.getElementById('peerKeyHint').style.display = 'none';
  fillIfaceSelect('peerIface', p.interface);
  document.getElementById('peerModalTitle').textContent = 'Edit Peer WireGuard';
  document.getElementById('peerModal').classList.add('show');
}
async function savePeer() {
  const id = document.getElementById('peerId').value;
  const body = {
    interface: document.getElementById('peerIface').value,
    comment: document.getElementById('peerComment').value.trim(),
    allowedAddress: document.getElementById('peerAllowed').value.trim(),
    publicKey: document.getElementById('peerPub').value.trim(),
    endpointAddress: document.getElementById('peerEp').value.trim(),
    endpointPort: document.getElementById('peerEpPort').value.trim(),
    keepalive: document.getElementById('peerKa').value.trim()
  };
  const url = id ? '/mikrotik/wireguard/peers/' + encodeURIComponent(id) : '/mikrotik/wireguard/peers';
  const r = await App.api(_url(url), { method: id ? 'PUT' : 'POST', body: JSON.stringify(body) });
  if (r?.success) {
    closeModal('peerModal');
    if (r.data && r.data.privateKey) {
      App.showToast('Peer dibuat. Simpan private key klien: ' + r.data.privateKey, 'success');
    } else App.showToast(r.message, 'success');
    await loadAll();
  } else App.showToast(r?.message || 'Gagal', 'error');
}
async function delPeer(id) {
  if (!confirm('Hapus peer ini?')) return;
  const r = await App.api(_url('/mikrotik/wireguard/peers/' + encodeURIComponent(id)), { method:'DELETE' });
  App.showToast(r?.success ? 'Dihapus' : (r?.message || 'Gagal'), r?.success ? 'success' : 'error');
  await loadAll();
}

document.addEventListener('DOMContentLoaded', () => {
  if (window.App && typeof App.init === 'function') App.init();
  if (window.MikrotikSelector) {
    window.MikrotikSelector.init({
      onReady: () => loadAll(),
      onChange: () => loadAll()
    });
  } else {
    loadAll();
  }
});
</script>
</body>
</html>
